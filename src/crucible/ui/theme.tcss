/* CRUCIBLE — tempered steel on charcoal, Magnitude-school calm:
 * ONE rounded hero panel per screen, uppercase dim micro-headers instead of
 * boxes-in-boxes, hints as quiet text lines, a slim ambient bar at the bottom.
 *
 * Color semantics:
 *   $primary  — structure & the path: crumb, hero border, THE primary action
 *   $accent   — content highlights only, sparingly
 *   $warning  — exactly one meaning: a decision is pending
 *   muted     — the guidance layer; it must recede
 */

/* ---- shared vocabulary ---- */

.hero {
    border: round $primary 30%;
    padding: 1 3;
    margin: 0 2;
    height: 1fr;
}

.micro {
    color: $text-muted;
    text-style: bold;
    margin-top: 1;
    height: auto;
}

.micro.first {
    margin-top: 0;
}

ScreenHeader {
    height: 1;
    padding: 0 2;
    margin-top: 1;
}

#crumb {
    width: auto;
    text-style: bold;
    color: $primary;
}

#context {
    width: 1fr;
    color: $text-muted;
    text-align: right;
}

Rule {
    color: $panel;
    margin: 0 1;
}

.step-hint {
    color: $text-muted;
}

.btn-compact {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
    margin: 1 0 0 1;
    background: transparent;
    color: $text-muted;
}

.btn-compact:hover {
    color: $primary;
}

.cta {
    width: 100%;
    height: 3;
    margin: 1 0 0 0;
}

HardwareBar {
    height: 1;
    padding: 0 3;
    color: $text-muted;
}

OptionList, SelectionList {
    background: transparent;
    border: none;
    padding: 0;
}

Label {
    padding: 1 1 0 0;
    color: $text-muted;
}

/* ---- Home ---- */

HomeScreen {
    align: center top;
}

HomeScreen ScreenHeader {
    dock: top;
}

#banner {
    width: auto;
    color: $primary;
    text-style: bold;
    margin-top: 2;
    margin-bottom: 1;
}

#menu {
    width: 78;
    height: auto;
    border: round $primary 30%;
    padding: 1 2;
    margin-bottom: 1;
}

#menu:focus {
    border: round $primary 60%;
}

#home-status, #home-hint {
    width: auto;
    color: $text-muted;
}

/* ---- stages ---- */

ContentSwitcher {
    height: 1fr;
}

#bench-setup-cols {
    height: 1fr;
}

#bench-steps {
    width: 1fr;
}

#bench-models {
    height: 1fr;
    min-height: 4;
}

#bench-models-msg, #sess-models-msg {
    color: $text-muted;
}

#bench-history-panel {
    width: 36;
    margin-left: 3;
}

#bench-history {
    height: 1fr;
}

#bench-runs {
    width: 8;
}

#bench-maxtok {
    width: 9;
}

#step-backend Select {
    width: 30;
}

/* run stage */

Bar > .bar--bar {
    color: $primary;
}

#bench-phase {
    height: 1;
    color: $text-muted;
}

#bench-progress {
    width: 100%;
    margin-top: 1;
}

#bench-stream {
    height: 3;
    color: $text-muted;
}

#bench-stop {
    margin-top: 2;
}

/* results stage */

#results-table {
    height: auto;
    max-height: 1fr;
    margin-top: 1;
}

#results-saved {
    color: $text-muted;
    margin-top: 1;
}

#results-errors {
    color: $text-muted;
}

#results-actions {
    height: auto;
    margin-top: 1;
}

#results-actions Button {
    margin-right: 2;
}

/* ---- Session ---- */

#sess-setup Horizontal {
    height: auto;
}

#sess-backend, #sess-model {
    width: 34;
    margin-right: 2;
}

#sess-approval {
    width: 24;
}

#sess-approval-hint {
    padding: 1 0 0 2;
    color: $text-muted;
}

#sess-approval-hint.caution {
    color: $warning;
}

#sess-explain {
    color: $text-muted;
    margin-top: 1;
}

#sess-run {
    padding: 0 2;
}

#session-panes {
    height: 1fr;
}

#chat-log, #term-log {
    width: 1fr;
    border: round $primary 20%;
    border-title-color: $text-muted;
    padding: 0 1;
}

#chat-log:focus, #term-log:focus {
    border: round $primary 60%;
}

#stream-tail {
    height: 1;
    color: $text-muted;
    padding: 0 2;
}

#task-input {
    margin-top: 1;
}

/* ---- Reports ---- */

#reports-list {
    width: 42;
    margin-right: 3;
}

#reports-options {
    height: 1fr;
}

#report-view-scroll {
    padding: 0 1;
}

/* ---- Config ---- */

ConfigScreen .form-row {
    height: auto;
}

ConfigScreen .form-row Label {
    width: 18;
    text-align: right;
    padding: 1 1 0 0;
}

ConfigScreen .form-row Input, ConfigScreen .form-row Select {
    width: 34;
}

ConfigScreen .form-desc-inline {
    width: 1fr;
    padding: 1 0 0 2;
    color: $text-muted;
}

#cfg-actions {
    height: auto;
    padding: 0 3;
    margin-top: 1;
}

#cfg-save {
    margin-right: 2;
}

#cfg-dirty {
    color: $warning;
    padding: 1 0 0 0;
}

/* ---- About ---- */

#about-scroll {
    max-width: 84;
    padding: 0 2;
}

/* ---- Modals ---- */

ConfirmModal {
    align: center middle;
}

#confirm-box {
    width: 60;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#confirm-box Horizontal {
    height: auto;
    align-horizontal: center;
    margin-top: 1;
}

#confirm-box Button {
    margin: 0 2;
}

ApprovalModal {
    align: center middle;
}

#approval-box {
    width: 72;
    height: auto;
    border: round $warning;
    background: $surface;
    padding: 1 3;
}

#approval-title {
    text-style: bold;
    color: $warning;
}

#approval-context {
    color: $text-muted;
    margin-top: 1;
}

#approval-cmd-scroll {
    max-height: 8;
    height: auto;
    margin: 1 0;
}

#approval-cmd {
    text-style: bold;
}

#approval-buttons {
    height: auto;
    align-horizontal: center;
}

#approval-buttons Button {
    margin: 0 1;
}

#approval-help {
    color: $text-muted;
    margin-top: 1;
}

#bench-steps .step-hint {
    padding: 1 0 0 1;
}

#machine {
    width: 78;
    height: auto;
    border: round $primary 30%;
    border-title-color: $text-muted;
    padding: 0 2;
    margin-bottom: 1;
}
